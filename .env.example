# ---------------------------------------------------------------------------
# Скопируйте этот файл в `.env` и заполните значения.
#   cp .env.example .env
# Файл `.env` НИКОГДА не коммитится (см. .gitignore) и не попадает в браузер.
# ---------------------------------------------------------------------------

# Ключ OpenAI API. Используется ТОЛЬКО на сервере (Vite middleware / Express).
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Модель OpenAI для ответов исторического помощника.
OPENAI_MODEL=gpt-4.1-mini

# Заголовок приложения (единственная переменная, доступная фронтенду).
VITE_APP_TITLE=Россия 1991-2022: линия времени

# ---------------------------------------------------------------------------
# Необязательно — для скрипта обогащения источниками (npm run enrich:events).
# Если не задано, используется безопасная заглушка MockSearchProvider и
# реальные сетевые запросы НЕ выполняются.
# Поддерживаемые провайдеры: mock | tavily
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
